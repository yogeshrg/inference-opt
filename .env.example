# Application
APP_NAME="Inference Optimization"
APP_VERSION="0.1.0"
DEBUG=false
LOG_LEVEL=INFO

# Server
HOST=0.0.0.0
PORT=8003

# Model
MODEL_NAME=meta-llama/Meta-Llama-3.1-8B
MODEL_PATH=
DEVICE=auto
DTYPE=float16

# Quantization
QUANT_METHOD=awq
QUANT_BITS=4
QUANT_GROUP_SIZE=128
QUANT_CALIBRATION_SAMPLES=512

# Speculative Decoding
SPECULATIVE_ENABLED=true
DRAFT_MODEL_NAME=meta-llama/Meta-Llama-3.1-8B
DRAFT_MODEL_PATH=
ACCEPTANCE_THRESHOLD=0.9
MAX_DRAFT_TOKENS=5

# KV Cache
KV_CACHE_ENABLED=true
KV_CACHE_DTYPE=float16
MAX_KV_CACHE_SIZE=1073741824
KV_CACHE_OFFLOAD=false

# Batching
CONTINUOUS_BATCHING=true
MAX_BATCH_SIZE=32
MAX_WAITING_TOKENS=20

# Benchmark
BENCHMARK_WARMUP=3
BENCHMARK_RUNS=10
BENCHMARK_PROMPT_LENGTHS=[128, 512, 1024, 2048]
BENCHMARK_GEN_LENGTHS=[128, 256, 512]

# Model Storage
MODEL_CACHE_DIR=./models
QUANT_OUTPUT_DIR=./models/quantized